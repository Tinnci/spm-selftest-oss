{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPM Self-Test",
  "version": "0.1.2",
  "identifier": "dev.tinnci.selftest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SPM 自测",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": true,
        "shadow": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
