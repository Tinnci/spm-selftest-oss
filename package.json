{
  "name": "spm-selftest",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1430 --strictPort",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri",
    "desktop:build": "npm run build && cargo build --locked --manifest-path src-tauri/Cargo.toml --bins",
    "desktop:package": "node scripts/package-desktop.mjs",
    "test": "vitest run",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint --max-warnings=0 .",
    "lint:fix": "eslint . --fix",
    "lint:comments": "node scripts/comment-ratchet.mjs",
    "lint:comments:update": "node scripts/comment-ratchet.mjs --update",
    "format": "prettier --write --cache --cache-location node_modules/.cache/prettier \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html}\"",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html}\"",
    "check:versions": "node scripts/check-versions.mjs",
    "cli:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin spm-selftest-cli",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "node scripts/check-all.mjs",
    "check:changed": "node scripts/check-changed.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.3",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
